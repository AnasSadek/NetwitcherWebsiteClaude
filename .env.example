# Copy this file to .env.local for local development and fill in real values
# there — .env.local is git-ignored and must never be committed. In
# production (Plesk), set these as server/application environment variables,
# not as a committed file.
#
# Used by app/api/contact/route.ts (via lib/graph-mailer.ts) to send the
# contact-form inquiry through Microsoft Graph. Server-only — never prefix
# any of these with NEXT_PUBLIC_, or they would ship to the browser.

# Azure App Registration (Microsoft Graph, Mail.Send application permission,
# client-credentials flow).
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# The mailbox Graph sends from (must be a real, licensed mailbox the app
# registration is allowed to send as).
MAIL_FROM=noreply@netwitcher.com

# Where contact-form inquiries are delivered internally.
CONTACT_RECIPIENT_EMAIL=info@netwitcher.com

# Optional: where the temporary diagnostic log file is written
# (lib/contact-logger.ts). Defaults to contact-debug.log in the app's own
# working directory if unset (visible in Plesk File Manager under the
# domain) — only set this to redirect it elsewhere.
# CONTACT_LOG_FILE=/absolute/or/relative/path/to/contact-debug.log
